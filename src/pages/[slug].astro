---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { expandProducts } from '../lib/products';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter(p => !p.data.isPage)
    .map(post => ({
      params: { slug: post.data.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { title, description, tags, pubDate, featuredImage } = post.data;

function formatDate(dateStr?: string) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

function readingTime(html: string) {
  const text = html.replace(/<[^>]+>/g, '');
  const words = text.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 250));
}

function stripTags(html: string) {
  return html.replace(/<[^>]+>/g, '').trim();
}

function extractFaqItems(html: string) {
  const faqMatch = html.match(/<h2[^>]*>\s*Frequently\s+asked\s+questions\s*<\/h2>([\s\S]*?)(?=<h2[\s>]|$)/i);
  if (!faqMatch) return [];
  const items: { question: string; answer: string }[] = [];
  const regex = /<h3[^>]*>([\s\S]*?)<\/h3>\s*<p>([\s\S]*?)<\/p>/g;
  let m;
  while ((m = regex.exec(faqMatch[1])) !== null) {
    const q = stripTags(m[1]);
    const a = stripTags(m[2]);
    if (q && a) items.push({ question: q, answer: a });
  }
  return items;
}

const mins = post.body ? readingTime(post.body) : 1;
const hasImage = featuredImage && !featuredImage.includes('ghost.org');
const tagClasses = tags.map(t => `tag-${t.toLowerCase().replace(/\s+/g, '-')}`).join(' ');
const bodyHasH1 = !!post.body && /^\s*(?:<[^>]+>\s*)*<h1\b/i.test(post.body);

// Suppress the sitewide Amazon CTA on product roundups (they have their own
// product cards already) and on the gift hub itself (it IS the destination).
const isProductsPost = tags.includes('Products');
const isGiftHub = post.data.slug === 'best-gifts-for-left-handed-people';
const showAmazonCta = !isProductsPost && !isGiftHub;

// Split the body so the CTA can land between the intro/TL;DR and the first
// real deep-dive H2 — that's where most readers' eyes are when they decide
// whether to keep reading or bounce. Injecting here captures the cookie at
// the highest-attention moment.
function splitBodyAtFirstSection(html: string): [string, string] {
  if (!html) return ['', ''];
  const matches = [...html.matchAll(/<h2[^>]*>/gi)];
  if (matches.length === 0) return [html, ''];
  // Skip the TL;DR's own H2 (id="tldr") if present; split at the first
  // content-section H2 instead.
  const firstContentH2 = matches.find(m => !/id=["']tldr["']/i.test(m[0]))
    ?? matches[0];
  const idx = firstContentH2.index ?? 0;
  return [html.slice(0, idx), html.slice(idx)];
}
const [bodyTop, bodyRest] = splitBodyAtFirstSection(expandProducts(post.body || ''));

// Build extra schemas
const extraSchemas: Record<string, any>[] = [];
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://lefthanded.io';

// BreadcrumbList
const firstTag = tags[0];
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
];
if (firstTag) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: firstTag,
    item: `${siteUrl}/tag/${firstTag.toLowerCase().replace(/\s+/g, '-')}/`,
  });
}
breadcrumbItems.push({
  '@type': 'ListItem',
  position: firstTag ? 3 : 2,
  name: title,
  item: `${siteUrl}/${post.data.slug}/`,
});
extraSchemas.push({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
});

// FAQPage schema (if post has FAQ section)
if (post.body) {
  const faqItems = extractFaqItems(post.body);
  if (faqItems.length > 0) {
    extraSchemas.push({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    });
  }
}
---

<BaseLayout title={title} description={description} ogImage={featuredImage} ogType="article" pubDate={pubDate} updatedDate={post.data.updatedDate} bodyClass={`post-template ${tagClasses}`} extraSchemas={extraSchemas}>
  <div class="content-area">
    <main class="site-main">
      <article class={`post ${tagClasses} single-post`}>
        <header class="post-header big-title container medium">
          {!bodyHasH1 && <h1 class="post-title">{title}</h1>}
          <div class="post-meta">
            <span class="post-meta-item post-meta-date">
              <time datetime={pubDate?.split('T')[0]}>
                {formatDate(pubDate)}
              </time>
            </span>
            <span class="post-meta-item post-meta-length">
              {mins} min read
            </span>
            {tags.length > 0 && (
              <span class="post-meta-item post-meta-tags">
                {tags.map(tag => {
                  const tagSlug = tag.toLowerCase().replace(/\s+/g, '-');
                  return <a class={`post-tag post-tag-${tagSlug}`} href={`/tag/${tagSlug}/`} title={tag}>{tag}</a>;
                })}
              </span>
            )}
          </div>
        </header>

        {hasImage && (
          <figure class="post-media container large">
            <div class={`u-placeholder horizontal ${featuredImage?.includes('/portraits/') ? 'has-portrait' : ''}`} style={featuredImage?.includes('/portraits/') ? `--portrait: url(${featuredImage})` : undefined}>
              <img class={`post-image u-object-fit ${featuredImage?.includes('/portraits/') ? 'is-portrait' : ''}`} src={featuredImage} alt={title} loading="eager" fetchpriority="high">
            </div>
          </figure>
        )}

        <div class="post-content gh-content kg-canvas">
          <Fragment set:html={bodyTop} />
          {showAmazonCta && bodyRest && (
            <aside class="amazon-cta" aria-label="Shop left-handed gifts">
              <h3 class="amazon-cta-title">Looking for a great left-handed gift?</h3>
              <p class="amazon-cta-text">Browse our curated picks or jump straight to Amazon's full selection — funny mugs, lefty notebooks, ergonomic tools, and more.</p>
              <div class="amazon-cta-buttons">
                <a href="/best-gifts-for-left-handed-people/" class="amazon-cta-btn amazon-cta-btn-primary">Browse our gift guide</a>
                <a href="/go/lefty-gifts" class="amazon-cta-btn amazon-cta-btn-secondary" target="_blank" rel="nofollow sponsored noopener">Shop on Amazon →</a>
              </div>
              <p class="amazon-cta-disclosure">As an Amazon Associate, lefthanded.io earns from qualifying purchases.</p>
            </aside>
          )}
          <Fragment set:html={bodyRest} />
        </div>

        <div class="container medium">
          <section class="author">
            <div class="author-image-placeholder u-placeholder">
              <img class="author-image u-object-fit" src="/content/images/size/w150/2024/02/sammy-southpaw.jpeg" alt="Sammy Southpaw">
            </div>
            <div class="author-wrapper">
              <header class="author-header">
                <div class="author-header-wrapper">
                  <h4 class="author-name">Sammy Southpaw</h4>
                </div>
              </header>
              <div class="author-bio">Sammy Southpaw: Left-handed, left-leaning, and left in every sense of the word. Writer, musician, and southpaw enthusiast.</div>
              <div class="author-location">
                <i class="author-location-icon icon icon-map-marker"></i> Atlanta
              </div>
            </div>
          </section>
        </div>
      </article>
    </main>
  </div>
</BaseLayout>

<style is:global>
  .kg-product-card .kg-product-card-image {
    width: auto;
    max-width: 100%;
    max-height: 300px;
    margin: 0 auto;
    object-fit: contain;
  }
  .gh-content th { text-align: left; }
  .top-picks {
    margin: 3.2rem 0;
    padding: 2rem 2.4rem 1.2rem;
    border: 1px solid var(--light-gray-color, #e6e6e6);
    border-left: 4px solid var(--ghost-accent-color);
    border-radius: 8px;
  }
  .top-picks-heading {
    margin: 0 0 0.8rem;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ghost-accent-color);
  }
  .top-picks-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .top-picks-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin: 0;
    padding: 1.2rem 0;
    border-top: 1px solid var(--light-gray-color, #e6e6e6);
  }
  .top-picks-badge {
    flex-shrink: 0;
    padding: 0.4rem 0.8rem;
    border-radius: 3px;
    background: var(--ghost-accent-color);
    color: #fff;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .top-picks-info {
    flex: 1;
    min-width: 0;
  }
  .top-picks-name {
    display: block;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .top-picks-reason {
    display: block;
    font-size: 1.4rem;
    line-height: 1.4;
    color: var(--secondary-text-color);
  }
  .gh-content a.top-picks-cta,
  .top-picks-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.4rem;
    border-radius: 6px;
    background: var(--ghost-accent-color);
    color: #fff;
    font-size: 1.3rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }
  .top-picks-disclosure {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--light-gray-color, #e6e6e6);
    font-size: 1.2rem;
    color: var(--secondary-text-color);
  }
  @media (max-width: 600px) {
    .top-picks-row { flex-wrap: wrap; }
    .top-picks-info { flex: 1 1 60%; }
    .top-picks-cta { margin-left: auto; }
  }
  .amazon-cta {
    margin: 4.8rem 0 2rem;
    padding: 2.4rem 2.8rem;
    background-color: #f6f9fc;
    border: 1px solid #e1e8ed;
    border-left: 4px solid var(--primary-color, #49a8e4);
    border-radius: 8px;
  }
  .amazon-cta-title {
    font-size: 1.9rem;
    font-weight: 800;
    margin: 0 0 0.6rem;
    line-height: 1.3;
  }
  .amazon-cta-text {
    font-size: 1.5rem;
    line-height: 1.5;
    margin: 0 0 1.6rem;
    color: var(--primary-text-color, #333);
  }
  .amazon-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }
  .amazon-cta-btn {
    display: inline-block;
    padding: 1rem 1.8rem;
    border-radius: 6px;
    font-size: 1.4rem;
    font-weight: 800;
    text-decoration: none !important;
    transition: opacity 0.2s ease-in-out, transform 0.1s ease-in-out;
  }
  .amazon-cta-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }
  .amazon-cta-btn-primary {
    background-color: var(--primary-color, #49a8e4);
    color: #fff !important;
  }
  .amazon-cta-btn-secondary {
    background-color: #ff9900;
    color: #111 !important;
  }
  .amazon-cta-disclosure {
    font-size: 1.2rem;
    color: var(--secondary-text-color, #888);
    margin: 0;
    font-style: italic;
  }
  .dark-mode .amazon-cta {
    background-color: var(--dark-mode-darker-bg-color, #21252c);
    border-color: var(--dark-mode-border-color, #495061);
  }
  .dark-mode .amazon-cta-text {
    color: var(--dark-mode-primary-text-color, #ccc);
  }
  .dark-mode .amazon-cta-disclosure {
    color: var(--dark-mode-secondary-text-color, #999);
  }
  @media (max-width: 575px) {
    .amazon-cta { padding: 2rem 1.8rem; }
    .amazon-cta-btn { display: block; text-align: center; }
  }

  /* Thumbnail gallery for the famous-left-handed-people hub. */
  .lefty-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1.6rem;
    margin: 2rem 0 1rem;
    padding: 0;
    list-style: none;
  }
  .lefty-gallery-item {
    margin: 0;
    text-align: center;
  }
  .lefty-gallery-item img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease-in-out;
  }
  .lefty-gallery-item img:hover {
    transform: scale(1.03);
  }
  .lefty-gallery-item figcaption {
    font-size: 1.3rem;
    font-weight: 700;
    margin-top: 0.6rem;
    text-align: center;
    color: var(--primary-text-color, #333);
  }
  .lefty-gallery-credit {
    font-size: 1.2rem;
    color: var(--secondary-text-color, #888);
    font-style: italic;
    margin: 0.5rem 0 2rem;
  }
  .dark-mode .lefty-gallery-item figcaption {
    color: var(--dark-mode-primary-text-color, #ccc);
  }
  .dark-mode .lefty-gallery-credit {
    color: var(--dark-mode-secondary-text-color, #999);
  }
</style>
