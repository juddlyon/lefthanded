---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const choosePost = allPosts.find(p => p.data.slug === 'how-we-choose-products');
---

<BaseLayout title="How We Choose Products" description={choosePost?.data.description} bodyClass="page-template page-how-we-choose-products">
  <div class="content-area">
    <main class="site-main">
      <article class="post single-post">
        <header class="post-header big-title container medium">
          <h1 class="post-title">How We Choose Products</h1>
        </header>
        <div class="post-content gh-content kg-canvas" set:html={choosePost?.body} />
      </article>
    </main>
  </div>
</BaseLayout>
